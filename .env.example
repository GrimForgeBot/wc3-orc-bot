# GrimForge Shorts Pipeline — environment variables
# Copy to .env and source before running: source .env

# Claude API (script generation)
# Get key: console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# OBS WebSocket (Tools > WebSocket Server Settings in OBS)
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your_obs_password_here
OBS_SCENE_GAMEPLAY="WC3 Gameplay"

# ElevenLabs (optional — edge-tts is free fallback)
# Get key: elevenlabs.io → Starter plan ~€5.50/month
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# YouTube OAuth credentials go in .secrets/ (not here)
# See tools/shorts_pipeline/upload_youtube.py for setup instructions
